# Lark / Feishu App
APP_ID=cli_xxx
APP_SECRET=xxx
LARK_DOMAIN=https://open.feishu.cn

# Webhook (optional; if you use callback URL mode)
VERIFICATION_TOKEN=
ENCRYPT_KEY=

# Backward compatible (old env var names)
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# Feishu Low-Code Platform (ae-openapi) OpenAPI
# Used to fetch appToken automatically for /lark/app/objects & /lark/app/data/objects/* endpoints.
OPENAPI_CLIENT_ID=
OPENAPI_CLIENT_SECRET=
OPENAPI_NAMESPACE=
#
# Optional: pre-issued Authorization token from AE OpenAPI page (e.g. "T:xxxx").
# If set, backend will skip /auth/v1/appToken.
OPENAPI_TOKEN=
